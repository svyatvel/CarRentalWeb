<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Drive Rental</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-page="/Index">
            <span class="brand-mark">D</span>
            <span>DRIVE<span>RENTAL</span></span>
        </a>
        <nav>
            <a class="active" asp-page="/Index">Автомобілі</a>
            <a href="#booking">Бронювання</a>
        </nav>
        <a class="phone" href="tel:+380000000000">+38 (000) 000-00-00</a>
    </header>
    @RenderBody()

    <footer>
        <span>© 2026 DriveRental</span>
        <span>Надійна оренда автомобілів</span>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
